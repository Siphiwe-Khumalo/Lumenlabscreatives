# Copy this file to ".env" (same folder) on the host PC and fill it in.
# .env holds the JACE credentials: it is never committed to git and never served to browsers.
# One setting per line: KEY=value. Paste values exactly; no quotes needed (# and $ are fine).

# Address of the JACE web server, e.g. https://192.168.1.50
JACE_URL=https://192.168.1.140

# ossRestApi OAuth client credentials (from the credentials document)
OSS_CLIENT_ID=
OSS_CLIENT_SECRET=

# OR, instead of the OAuth client: a Niagara station user that has the HTTP Basic
# authentication scheme (Workbench: UserService > user > Authentication Scheme Name = HTTPBasicScheme).
# When both are set the station user is used.
JACE_USER=
JACE_PASSWORD=

# The API paths are fixed in scripts/oss-auth.mjs (same as ARC): <JACE_URL>/ossRestApiServer/token,
# /ossRestApiServer/query/readPoint/... Credentials are sent as HTTP Basic, scope "read write".

# JACEs normally use a self-signed certificate. Set to true only on the site network.
JACE_ALLOW_SELF_SIGNED=true

# Dashboard server. Use HOST=0.0.0.0 on the host PC so phones/laptops on the VPN can open it.
HOST=0.0.0.0
PORT=8080

# History logging (scripts/history.mjs): every point of every unit is recorded on this PC.
# Minutes between recordings (default 5). Daily CSV logs + per-point files go to HISTORY_DIR.
LOG_INTERVAL_MIN=5
HISTORY_DIR=data/history
# Set HISTORY_LOG=off to stop recording (stored logs stay available).
HISTORY_LOG=on

# Gateway read cache (ms): all screens and the history logger share one JACE read per point within this time.
READ_CACHE_MS=5000
