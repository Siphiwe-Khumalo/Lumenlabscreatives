# Lumen Outreach backend configuration. PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env for local development; on a host, set these in its environment settings.

# --- Deployment -------------------------------------------------------------
# "production" enforces https and requires PUBLIC_BASE_URL.
NODE_ENV=production
PORT=3000
# Public origin of the deployed backend: scheme + host, no path, no trailing slash.
# The OAuth redirect URI is derived from this: PUBLIC_BASE_URL + OAUTH_CALLBACK_PATH.
# Local development: leave unset to use http://localhost:PORT.
PUBLIC_BASE_URL=https://<your-backend-host>
# Path of the OAuth callback route. Change only if you need to; update Google Cloud to match.
OAUTH_CALLBACK_PATH=/auth/google/callback
# Number of reverse proxies in front of the app (most PaaS hosts: 1).
TRUST_PROXY=1

# --- Google OAuth client (Web application) ---------------------------------
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>

# --- Secrets (generate with: npm run gen-secrets) --------------------------
# 32 random bytes, base64. Encrypts the stored Gmail refresh/access tokens.
TOKEN_ENCRYPTION_KEY=<base64-32-bytes>
# Signs the session and OAuth-state cookies. At least 32 characters.
SESSION_SECRET=<random-string-at-least-32-chars>
# Password to unlock THIS app (min 12 chars). NOT your Gmail password.
APP_ACCESS_PASSWORD=<choose-a-long-passphrase>
SESSION_TTL_HOURS=12

# --- Storage ----------------------------------------------------------------
# Directory for the state file (encrypted tokens + batch history).
# Must be on persistent storage in production, or you'll need to reconnect
# Gmail and lose send history after every redeploy.
DATA_DIR=./data

# --- Sending ----------------------------------------------------------------
# Max messages per calendar day (counted in DAILY_CAP_TIMEZONE).
DAILY_SEND_CAP=20
DAILY_CAP_TIMEZONE=Africa/Johannesburg
# Pause between individual messages in a batch (ms).
MIN_SEND_INTERVAL_MS=2000
# How long to wait for Gmail before treating a send as Uncertain (ms).
GMAIL_SEND_TIMEOUT_MS=30000
# Optional: your Gmail address and display name for the From header.
# Leave SENDER_EMAIL empty to let Gmail use the connected account's address.
SENDER_EMAIL=
SENDER_NAME=
